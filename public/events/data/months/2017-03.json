    {
      "id": "2017-03-31-vary-presents-dexter",
      "date": "2017-03-31",
      "title": "VARY PRESENTS ⁓ DEXTER",
      "color": "olive",
      "moreUrl": "https://web.archive.org/web/20170507211553id_/http://www.distillery.de:80/ex/dates/2017/03/31",
      "imageUrl": "",
      "description": "",
      "sections": [
        {
          "label": "up:",
          "items": [
            {
              "name": "DEXTER",
              "info": "Melting Pot Music / Wortsport, Stuttgart",
              "link": ""
            },
            {
              "name": "SKOR ROKSWELL",
              "info": "VARY, Champion Sound, Leipzig",
              "link": ""
            },
            {
              "name": "SHAPE",
              "info": "VARY, Chopy Wood, Leipzig, Start: 23:30, add to Cal, Die Jungs aus dem Plattenladen machen Stop in der Tille und haben neben jeder Menge Scheiben auch Dexter im Gepäck. Selbst wer mit diesem Namen noch nicht vertraut ist, hat ohne Zweifel schon mal den einen oder anderen Beat des Stuttgarters gehört: Ob als Solokünstler, der sich den Beats wie auch dem Rap, dem Hip Hop wie dem Jazz verschrieben hat, ob als Teil des Kollaboprojekts Betty Ford Boys“ oder als Produzent für Cro und Casper. Der musikalische Lebenslauf von Dexter macht es schwer, an ihm vorbei zu kommen. Wollen wir aber auch gar nicht, sondern freuen uns stattdessen auf – wie das Internet sagen würde: Vary party. Much beats. Wow., https://soundcloud.com/dexter-1-1",
              "link": ""
            }
          ],
          "genre": ""
        }
      ]
