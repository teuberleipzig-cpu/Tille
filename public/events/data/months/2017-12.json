      "sections": [
        {
          "label": "up:",
          "items": [
            {
              "name": "BARNEY MILLAH",
              "info": "Yaam, Berlin",
              "link": ""
            },
            {
              "name": "HIGH POWER STATION",
              "info": "Dash Out, Teameastgermany, Leipzig / Köln, Start: 23:00, add to Cal, Es heißt noch ein letztes Mal, Dash Out!, für dieses Jahr und um dem Ruf des jamaikanischsten Dance gerecht zu bleiben, haben sich die Rude Boys von, High Power Station, eine absolute Ko­ry­phäe eingeladen:, Barney Millah, zählt zu den bekanntesten deutschen Reggae DJs und Radiomoderatoren und kann auf eine mehr als 20jährige Karriere zurückblicken. Er war maßgeblich daran beteiligt, Reggae und Dancehall in die ganze Republik zu tragen, betrieb mit \"Concrete Jungle\" eines der ersten Soundsystems Deutschlands, gilt als Pionier in Sachen Calypso und Soca und moderierte die allererste bundesweit im Kabel ausgestrahlte Reggae-Radiosendung. Geballte Power also, die da heute auf uns trifft… Rewind!",
              "link": ""
            }
          ],
          "genre": ""
        }
      ]
