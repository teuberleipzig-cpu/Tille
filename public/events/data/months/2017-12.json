      "id": "2017-12-29-dash-out-3",
      "date": "2017-12-29",
      "title": "DASH OUT #3",
      "color": "olive",
      "moreUrl": "https://web.archive.org/web/20190819110454id_/http://www.distillery.de/ex/dates/2017/12/29",
