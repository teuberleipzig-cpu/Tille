    {
      "id": "2013-05-15-baddas-radio-show-uplitment-intl-pres-ward-21",
      "date": "2013-05-15",
      "title": "BADDAS RADIO SHOW & UPLITMENT INTL. PRES. WARD 21",
      "color": "yellow",
      "moreUrl": "https://web.archive.org/web/20190920042357id_/http://www.distillery.de/ex/dates/2013/05/15",
      "imageUrl": "",
      "description": "",
      "sections": [
        {
          "label": "up: ward21",
          "items": [
            {
              "name": "WARD 21",
              "info": "Greensleeves, Kingston, Jamaica",
              "link": ""
            },
            {
              "name": "UPLIFTMENT INTERNATIONAL",
              "info": "Leipzig",
              "link": ""
            },
            {
              "name": "MR. DAGGA",
              "info": "Caribbean Nice Up",
              "link": ""
            },
            {
              "name": "SELECTAH SPINBACK",
              "info": "Spinbaclaat/ DaSwitch, Leipzig, Start: 21:00, add to Cal, \"Mentally Disturbed\" hieß das erste Album, was ja auch nahe liegt wenn man den Crewnamen nach der Psychiatrieabteilung des Universitätskrankenhauses in Kingston wählt. Textlich gesehen setzt sich dieser rote Faden durchaus fort und führte am Ende zu Hits wie \"Ganja Smoke\", \"Reggae Pledge\", \"Garrisson\", \"Grimey\" oder \"Petrol\" auf dem Remake des wunderbaren Peenie Peenie Riddim. In den letzten Jahren ist es um Suku, Rumblood und Kunley leider etwas ruhig geworden. Das letzte gemeinsame Album liegt schon ein paar Jahre zurück und die Europa-Tourneen wurden seltener. Umso schöner, sie heute zum ersten Mal live in Leipzig begrüßen zu können, denn ihre Bühnenshow ist nachwievor unschlagbar. U know how we roll!, https://www.facebook.com/Ward21Music, http://www.da-switch.de",
              "link": ""
            }
          ],
          "genre": ""
        }
      ]
