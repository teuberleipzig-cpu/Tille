    {
      "id": "2014-05-29-kugeleisdonnerstag-21-selectors-special",
      "date": "2014-05-29",
      "title": "KUGELEISDONNERSTAG #21 - SELECTORS SPECIAL",
      "color": "yellow",
      "moreUrl": "https://web.archive.org/web/20170403153823id_/http://www.distillery.de/ex/dates/2014/05/29",
      "imageUrl": "",
